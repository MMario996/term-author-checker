// Liefert den Text zu key in der UI-Sprache des Nutzers (Fallback Englisch, dann
// der Key selbst) und setzt {platzhalter} aus vars ein.
function _ct_(key, vars) {
  var lang = 'en';
  try { lang = getUiLangPref_(); } catch (e) {}
  var dict = CARD_I18N[lang] || CARD_I18N.en;
  var s = (key in dict) ? dict[key] : (key in CARD_I18N.en ? CARD_I18N.en[key] : key);
  if (vars) {
    s = s.replace(/\{(\w+)\}/g, function(m, name) { return (name in vars) ? String(vars[name]) : m; });
  }
  return s;
}

// Sprachname in der UI-Sprache (fuer die Sprachauswahl der Drive-PDF-Pruefung);
// ohne Intl.DisplayNames bleibt der englische Name.
function _ctLangName_(code, fallback) {
  try {
    var names = new Intl.DisplayNames([getUiLangPref_()], { type: 'language' });
    var n = names.of(code);
    if (n && n !== code) return n.charAt(0).toUpperCase() + n.slice(1);
  } catch (e) {}
  return fallback;
}
